# systemd unit для RAGE:MP сервера RedAge.
# Установка: sudo cp deploy/redage.service /etc/systemd/system/ && sudo systemctl daemon-reload
#            sudo systemctl enable --now redage
[Unit]
Description=RedAge RAGE:MP server
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ragemp
WorkingDirectory=/opt/ragemp-srv
EnvironmentFile=/etc/redage/redage.env
ExecStart=/opt/ragemp-srv/ragemp-server
Restart=on-failure
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
