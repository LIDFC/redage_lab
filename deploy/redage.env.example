# Секреты сервера RedAge. Скопируйте в /etc/redage/redage.env (Linux) и заполните.
# Значения перекрывают settings/mainDB.json и settings/donationsSettings.json.

# Основная БД (из неё же берутся <NAME>config и <NAME>logs)
REDAGE_DB_HOST=127.0.0.1
REDAGE_DB_NAME=ra3_main
REDAGE_DB_USER=redage
REDAGE_DB_PASSWORD=change-me

# БД донатов (нужна только при DonationsSettings.IsCheck = true)
#REDAGE_DONATE_DB_HOST=127.0.0.1
#REDAGE_DONATE_DB_NAME=payments
#REDAGE_DONATE_DB_USER=redage_payments
#REDAGE_DONATE_DB_PASSWORD=change-me

# Redis (host:port)
REDAGE_REDIS_HOST=127.0.0.1:6379
#REDAGE_REDIS_PASSWORD=
